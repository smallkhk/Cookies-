Options -Indexes
RewriteEngine On

# Block direct access to PHP internals
RewriteRule ^(config|db)\.php$ - [F,L]

# Route extensionless api calls to .php files (app calls without extension)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([^./]+)$ api/$1.php [L]

# Route /api/* to api/ folder
RewriteRule ^api/(.*)$ api/$1 [L]

# Route /admin/* to admin/ folder
RewriteRule ^admin/(.*)$ admin/$1 [L]
